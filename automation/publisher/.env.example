# Copy this file to ".env" in the same folder and fill it in. NEVER share or commit .env.

# ── Brand MD console database (Supabase → Project Settings → API) ──
SUPABASE_URL=https://cwakauqxkvgpsspsyhdm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# optional: profile id of a "Hermes Bot" user so the activity log shows who did it
BOT_PROFILE_ID=

# ── Doctor Uncle Facebook Page + Instagram (Meta, see README step 2) ──
META_GRAPH_VERSION=v23.0
META_PAGE_ID=555118008306562
# leave blank: found automatically from the Page
META_IG_USER_ID=
# Page token OR a never-expiring System User token (Business Settings → System users)
META_PAGE_TOKEN=

# ── AI caption writer. Gemini watches the real video (best). DeepSeek is text-only fallback ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── YouTube: keep false until Google approves the YouTube API audit (README step 4) ──
YOUTUBE_ENABLED=false
YT_PRIVACY=public
YT_CATEGORY_ID=27

# ── Behaviour ──
EDIT_WINDOW_MINUTES=120
MAX_ATTEMPTS=3
KEEP_FILES=false
WORK_DIR=

# browser = Hermes uploads through Chrome (default) | api = upload through platform APIs
PUBLISH_MODE=browser
